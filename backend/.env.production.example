NODE_ENV=production
PORT=4000
LOG_LEVEL=info

# Optional, comma-separated. If Scoop serves the frontend itself, you usually
# do not need to set this unless a different origin will call the API directly.
ALLOWED_ORIGINS=

# Optional feature keys
OPENWEATHER_API_KEY=

# ── LLM (Claude is the only generation provider) ────────────────────────
ANTHROPIC_API_KEY=
# Default claude-haiku-5-5. The 2026-07-15 incident (a floating "-latest" alias
# that silently became a thinking model) is why the model is always named, never
# an alias; every call's tokens and estimated cost land in llm_usage.
#ANTHROPIC_MODEL=claude-haiku-5-5
# Healthchecks.io check for LLM health: /fail on a hard error, success on recovery.
#LLM_HEALTH_PING_URL=
# Embeddings: the compose file runs Ollama and sets these for every app service.
#EMBED_PROVIDER=ollama
#OLLAMA_BASE_URL=http://ollama:11434
# Global hard ceiling on generation calls per UTC day, all tasks/providers.
# On breach, callers fall back to deterministic output until midnight.
LLM_DAILY_CALL_CAP=2000
REDIS_URL=
BULLMQ_PREFIX=scoop
USE_BULLMQ=true
REQUIRE_REDIS=true
QUEUE_CONCURRENCY_INGESTION=1
QUEUE_CONCURRENCY_VIDEO=1
QUEUE_CONCURRENCY_ENRICHMENT=2
