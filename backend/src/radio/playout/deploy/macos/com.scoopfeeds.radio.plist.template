<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>com.scoopfeeds.radio</string>
  <key>ProgramArguments</key><array><string>/bin/bash</string><string>__LAUNCHER__</string></array>
  <key>RunAtLoad</key><true/>
  <key>KeepAlive</key><true/>
  <key>ThrottleInterval</key><integer>10</integer>
  <key>ProcessType</key><string>Interactive</string>
  <key>StandardOutPath</key><string>__HOME__/scoopfeeds-radio/logs/playout.out.log</string>
  <key>StandardErrorPath</key><string>__HOME__/scoopfeeds-radio/logs/playout.err.log</string>
</dict>
</plist>
