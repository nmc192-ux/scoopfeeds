# Dependencies
node_modules/
frontend/node_modules/
backend/node_modules/

# Build output
frontend/dist/

# Runtime data — SQLite DB, generated cards, rendered videos/audio,
# persisted social tokens. Everything in backend/data/ is regenerated at
# runtime and must never be committed (some entries also contain secrets).
backend/data/
# Explicit belt-and-braces: pulls of PRODUCTION data (scripts/pull-prod-db.mjs)
# land here. Already covered by backend/data/ above, but called out separately
# so the rule survives anyone ever narrowing that line — prod data (real user
# push subscriptions, article content) must never reach the repo.
backend/data/prod-live.db
backend/data/prod-live.db-*
backend/data/.prod-live.pull.*

# Claude Code internal worktrees
.claude/worktrees/

# Misplaced shell-redirect artifact (Windows-style "2>NUL" on macOS).
NUL

# Logs
*.log
backend/logs/

# Environment
.env
.env.local
.env.*.local

# OS
.DS_Store
Thumbs.db

# Editor
.vscode/
.idea/
*.swp

# Scratch replay/validation harnesses (reused locally, not committed)
backend/_*.mjs

# Local off-host extraction working copy of the prod snapshot (disposable, multi-GB)
backend/_pilot_data/

# Entity-sync DB (3 entity tables only) built off-host to ship to prod
backend/_entity_sync.db
.env.bak*

# J Loop local state
.claude/settings.local.json
J-LOOP-INBOX.md
.j-loop/
